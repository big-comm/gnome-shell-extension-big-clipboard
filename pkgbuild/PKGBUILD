# Maintainer: Tales A. Mendonça <talesam@gmail.com>

pkgname=gnome-shell-extension-copyous
pkgdesc="Modern clipboard manager extension for GNOME Shell (full rewrite of Pano)"
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
epoch=1
arch=('any')
license=('GPL-3.0-or-later')
url="https://github.com/big-comm/gnome-shell-extension-copyous"
depends=('gnome-shell>=48'
         'libgda6'
         'gsound')
makedepends=('git'
             'jq'
             'gettext'
             'zip'
             'gobject-introspection'
             'pnpm'
             'typescript'
             'sass'
             'appstream'
             'glib2'
             'make')
optdepends=('wl-clipboard: Wayland clipboard support')
provides=("$pkgname")
# Name the branch instead of relying on whatever makepkg resolves as the
# remote default: a package built from the wrong revision still builds and
# still installs, so the ref this compiles from belongs in the file.
source=("copyous::git+${url}.git#branch=main")
md5sums=('SKIP')

prepare() {
  cd "${srcdir}/copyous"

  # Clone with submodules if not already done
  git submodule update --init --recursive

  # Install dependencies
  pnpm install --frozen-lockfile --ignore-scripts
}

build() {
  cd "${srcdir}/copyous"

  # Build the extension using Make
  make RELEASE=1
}

check() {
  cd "${srcdir}/copyous"
  pnpm exec tsc --noEmit
  pnpm test
}

package() {
  cd "${srcdir}/copyous"

  local uuid="copyous@boerdereinar.dev"
  local schema="org.gnome.shell.extensions.copyous.gschema.xml"
  local destdir="${pkgdir}/usr/share/gnome-shell/extensions/${uuid}"

  install -d "${destdir}"

  # Extract the built extension zip
  bsdtar xvf "dist/${uuid}.zip" -C "${destdir}/"

  # Compile schemas in the extension directory
  if [ -f "${destdir}/schemas/${schema}" ]; then
    glib-compile-schemas "${destdir}/schemas/"
  fi

  # Install license
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
